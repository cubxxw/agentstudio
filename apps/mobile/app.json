{
  "expo": {
    "name": "AgentRoom",
    "slug": "agentstudio",
    "version": "0.1.0",
    "scheme": "agentstudio",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.agentstudio.app",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.agentstudio.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "AgentRoom",
      "shortName": "AgentRoom",
      "themeColor": "#3247a8",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png"
  }
}
